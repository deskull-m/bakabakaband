{
    "type": "object",
    "additionalProperties": false,
    "description": "固定アーティファクトの定義",
    "properties": {
        "version": {
            "type": "number",
            "description": "Version情報"
        },
        "artifacts": {
            "type": "array",
            "description": "固定アーティファクト定義定義を格納する配列",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "base_item",
                    "level",
                    "rarity",
                    "weight",
                    "cost"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9999
                    },
                    "name": {
                        "type": "object",
                        "description": "アーティファクト名",
                        "additionalProperties": false,
                        "required": [
                            "ja",
                            "en"
                        ],
                        "properties": {
                            "ja": {
                                "type": "string",
                                "description": "日本語アーティファクト名"
                            },
                            "en": {
                                "type": "string",
                                "description": "English Artifact Name"
                            }
                        }
                    },
                    "base_item": {
                        "type": "object",
                        "description": "ベースアイテム種別",
                        "additionalProperties": false,
                        "required": [
                            "type_value",
                            "subtype_value"
                        ],
                        "properties": {
                            "type_value": {
                                "type": "integer",
                                "description": "ベースアイテムカテゴリ",
                                "minimum": 1,
                                "maximum": 128
                            },
                            "subtype_value": {
                                "type": "integer",
                                "description": "ベースアイテムタイプ",
                                "minimum": 0,
                                "maximum": 128
                            }
                        }
                    },
                    "parameter_value": {
                        "type": "integer",
                        "description": "パラメータ補正値",
                        "minimum": -128,
                        "maximum": 128
                    },
                    "level": {
                        "type": "integer",
                        "description": "出現階層",
                        "minimum": 0,
                        "maximum": 128
                    },
                    "rarity": {
                        "type": "integer",
                        "description": "出現頻度。高いほど出にくい",
                        "minimum": 0,
                        "maximum": 255
                    },
                    "weight": {
                        "type": "integer",
                        "description": "重量",
                        "minimum": 0,
                        "maximum": 9999
                    },
                    "cost": {
                        "type": "integer",
                        "description": "売値",
                        "minimum": 0,
                        "maximum": 99999999
                    },
                    "base_ac": {
                        "type": "integer",
                        "description": "ベースAC",
                        "minimum": -99,
                        "maximum": 99
                    },
                    "base_dice": {
                        "type": "string",
                        "description": "ダメージダイス XdY形式",
                        "pattern": "[0-9]*d[0-9]*"
                    },
                    "hit_bonus": {
                        "type": "integer",
                        "description": "命中補正値",
                        "minimum": -99,
                        "maximum": 99
                    },
                    "damage_bonus": {
                        "type": "integer",
                        "description": "ダメージ補正値",
                        "minimum": -99,
                        "maximum": 99
                    },
                    "ac_bonus": {
                        "type": "integer",
                        "description": "AC補正値",
                        "minimum": -99
                    },
                    "activate": {
                        "type": "string",
                        "description": "発動能力"
                    },
                    "flags": {
                        "type": "array",
                        "description": "能力フラグ",
                        "items": {
                            "type": "string"
                        }
                    },
                    "flavor": {
                        "type": "object",
                        "description": "フレーバーテキスト",
                        "additionalProperties": false,
                        "required": [
                            "ja"
                        ],
                        "properties": {
                            "ja": {
                                "type": "string",
                                "description": "日本語フレーバーテキスト"
                            },
                            "en": {
                                "type": "string",
                                "description": "English Flavor Text"
                            }
                        }
                    }
                }
            }
        }
    },
    "required": [
        "version",
        "artifacts"
    ]
}
