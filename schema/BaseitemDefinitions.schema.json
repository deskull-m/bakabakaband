{
    "type": "object",
    "additionalProperties": false,
    "description": "ベースアイテムの定義",
    "properties": {
        "version": {
            "type": "number",
            "description": "Version情報"
        },
        "baseitems": {
            "type": "array",
            "description": "ベースアイテム定義定義を格納する配列",
            "additionalProperties": false,
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "itemkind",
                    "weight",
                    "cost"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9999
                    },
                    "name": {
                        "type": "object",
                        "description": "アイテム名",
                        "additionalProperties": false,
                        "required": [
                            "ja",
                            "en"
                        ],
                        "properties": {
                            "ja": {
                                "type": "string",
                                "description": "日本語アイテム名"
                            },
                            "en": {
                                "type": "string",
                                "description": "English Item Name"
                            }
                        }
                    },
                    "flavor_name": {
                        "type": "object",
                        "description": "未鑑定アイテム名",
                        "additionalProperties": false,
                        "required": [
                            "ja",
                            "en"
                        ],
                        "properties": {
                            "ja": {
                                "type": "string",
                                "description": "日本語未鑑定アイテム名"
                            },
                            "en": {
                                "type": "string",
                                "description": "English Unidentified Item Name"
                            }
                        }
                    },
                    "itemkind": {
                        "type": "object",
                        "description": "ベースアイテム種別",
                        "additionalProperties": false,
                        "required": [
                            "type_value",
                            "subtype_value"
                        ],
                        "properties": {
                            "type_value": {
                                "type": "integer",
                                "description": "ベースアイテムカテゴリ",
                                "minimum": 0,
                                "maximum": 128
                            },
                            "subtype_value": {
                                "type": "integer",
                                "description": "ベースアイテムタイプ",
                                "minimum": 0,
                                "maximum": 128
                            }
                        }
                    },
                    "parameter_value": {
                        "type": "integer",
                        "description": "パラメータ補正値",
                        "minimum": -9999,
                        "maximum": 9999
                    },
                    "level": {
                        "type": "integer",
                        "description": "出現階層",
                        "minimum": 0,
                        "maximum": 128
                    },
                    "weight": {
                        "type": "integer",
                        "description": "重量",
                        "minimum": 0,
                        "maximum": 9999
                    },
                    "cost": {
                        "type": "integer",
                        "description": "売値",
                        "minimum": 0,
                        "maximum": 99999999
                    },
                    "base_ac": {
                        "type": "integer",
                        "description": "ベースAC",
                        "minimum": -99,
                        "maximum": 99
                    },
                    "base_dice": {
                        "type": "string",
                        "description": "ダメージダイス XdY形式",
                        "pattern": "[0-9]*d[0-9]*"
                    },
                    "hit_bonus": {
                        "type": "integer",
                        "description": "命中補正値",
                        "minimum": -99,
                        "maximum": 99
                    },
                    "damage_bonus": {
                        "type": "integer",
                        "description": "ダメージ補正値",
                        "minimum": -99,
                        "maximum": 99
                    },
                    "ac_bonus": {
                        "type": "integer",
                        "description": "AC補正値",
                        "minimum": -99,
                        "maximum": 99
                    },
                    "alliance": {
                        "type": "string",
                        "description": "アイテムの製造元アライアンスタグ (例: AMBER, VALINOR, PHYREXIA等)"
                    },
                    "allocations": {
                        "type": "array",
                        "description": "アイテム出現階層と希少度の定義",
                        "items": {
                            "description": "出現階層と希少度の組",
                            "additionalProperties": false,
                            "required": [
                                "depth",
                                "rarity"
                            ],
                            "properties": {
                                "depth": {
                                    "type": "integer",
                                    "description": "出現階層",
                                    "minimum": 0,
                                    "maximum": 128
                                },
                                "rarity": {
                                    "type": "integer",
                                    "description": "希少度",
                                    "minimum": 0,
                                    "maximum": 255
                                }
                            }
                        }
                    },
                    "activate": {
                        "type": "string",
                        "description": "発動能力"
                    },
                    "flags": {
                        "type": "array",
                        "description": "能力フラグ",
                        "items": {
                            "type": "string"
                        }
                    },
                    "flavor": {
                        "type": "object",
                        "description": "フレーバーテキスト",
                        "additionalProperties": false,
                        "required": [
                            "ja"
                        ],
                        "properties": {
                            "ja": {
                                "type": "string",
                                "description": "日本語フレーバーテキスト"
                            },
                            "en": {
                                "type": "string",
                                "description": "English Flavor Text"
                            }
                        }
                    }
                }
            }
        }
    },
    "required": [
        "version",
        "baseitems"
    ]
}
