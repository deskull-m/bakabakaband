{
    "type": "object",
    "additionalProperties": false,
    "description": "MonsterRaceの定義",
    "properties": {
        "versions": {
            "type": "number",
            "description": "Version情報"
        },
        "monsters": {
            "type": "array",
            "description": "Monster定義を格納する配列",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "name",
                    "symbol",
                    "speed",
                    "hit_point",
                    "vision",
                    "armor_class",
                    "alertness",
                    "level",
                    "rarity",
                    "exp"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9999
                    },
                    "name": {
                        "type": "object",
                        "description": "モンスター名",
                        "additionalProperties": false,
                        "required": [
                            "ja",
                            "en"
                        ],
                        "properties": {
                            "ja": {
                                "type": "string",
                                "description": "日本語モンスター名"
                            },
                            "en": {
                                "type": "string",
                                "description": "English Monster Name"
                            }
                        }
                    },
                    "symbol": {
                        "type": "object",
                        "description": "表示される文字と色",
                        "additionalProperties": false,
                        "required": [
                            "character",
                            "color"
                        ],
                        "properties": {
                            "character": {
                                "type": "string",
                                "description": "表示される文字",
                                "pattern": "[a-zA-Z0-9!/.!?#$%&()@,;|*'`<>+{}=~\\[\\]]|\\\\"
                            },
                            "color": {
                                "type": "string",
                                "description": "表示される色",
                                "enum": [
                                    "Black",
                                    "White",
                                    "Gray",
                                    "Orange",
                                    "Red",
                                    "Green",
                                    "Blue",
                                    "Brown",
                                    "Dark Gray",
                                    "Light Gray",
                                    "Violet",
                                    "Yellow",
                                    "Light Red",
                                    "Light Green",
                                    "Light Blue",
                                    "Light Brown"
                                ]
                            }
                        }
                    },
                    "speed": {
                        "type": "integer",
                        "description": "加速。0を基準として-50～99",
                        "minimum": -50,
                        "maximum": 99
                    },
                    "hit_point": {
                        "type": "string",
                        "description": "体力。XdY形式",
                        "pattern": "[1-9][0-9]*d[1-9][0-9]*"
                    },
                    "vision": {
                        "type": "integer",
                        "description": "感知範囲。1マスあたり1",
                        "minimum": 0,
                        "maximum": 999
                    },
                    "armor_class": {
                        "type": "integer",
                        "description": "物理防御力",
                        "minimum": 0,
                        "maximum": 10000
                    },
                    "alertness": {
                        "type": "integer",
                        "description": "警戒度。0=起きた状態で生成。高いほど起きにくい。",
                        "minimum": 0,
                        "maximum": 255
                    },
                    "level": {
                        "type": "integer",
                        "description": "出現階層",
                        "minimum": 0,
                        "maximum": 128
                    },
                    "rarity": {
                        "type": "integer",
                        "description": "出現頻度。高いほど出にくい",
                        "minimum": 0,
                        "maximum": 255
                    },
                    "exp": {
                        "type": "integer",
                        "description": "獲得経験値",
                        "minimum": 0,
                        "maximum": 9999999
                    },
                    "evolve": {
                        "type": "object",
                        "description": "進化情報",
                        "additionalProperties": false,
                        "required": [
                            "need_exp",
                            "to"
                        ],
                        "properties": {
                            "need_exp": {
                                "type": "integer",
                                "description": "進化に必要な経験値",
                                "minimum": 0,
                                "maximum": 9999999
                            },
                            "to": {
                                "type": "integer",
                                "description": "進化先モンスターID",
                                "minimum": 1,
                                "maximum": 9999
                            }
                        }
                    },
                    "sex": {
                        "type": "string",
                        "description": "性別",
                        "enum": [
                            "MALE",
                            "FEMALE"
                        ]
                    },
                    "player_race": {
                        "type": "string",
                        "description": "プレイヤー種族固定指定 (提案C1)。トークンは r_info_player_race を参照。効果は未反映で prace フィールドのみ付与。"
                    },
                    "player_class": {
                        "type": "string",
                        "description": "プレイヤー職業固定指定 (提案C1)。トークンは r_info_player_class を参照。効果は未反映で pclass フィールドのみ付与。"
                    },
                    "grows_stats": {
                        "type": "boolean",
                        "description": "レベルアップ時に能力値も成長させるか (提案C2)。既定false=オプトイン。trueの個体のみ成長。"
                    },
                    "odds_correction_ratio": {
                        "type": "integer",
                        "description": "闘技場オッズ補正値。1/100を使用、100で等倍200で2倍",
                        "minimum": 1,
                        "maximum": 9999
                    },
                    "start_hp_percentage": {
                        "type": "integer",
                        "description": "出現時体力。1-99%",
                        "minimum": 1,
                        "maximum": 99
                    },
                    "artifacts": {
                        "type": "array",
                        "description": "固定アーティファクトドロップリスト",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "drop_artifact_id",
                                "drop_probability"
                            ],
                            "properties": {
                                "drop_artifact_id": {
                                    "type": "integer",
                                    "description": "ドロップアーティファクトID",
                                    "minimum": 1,
                                    "maximum": 999
                                },
                                "drop_probability": {
                                    "type": "integer",
                                    "description": "ドロップ率 1-100%",
                                    "minimum": 1,
                                    "maximum": 100
                                }
                            }
                        }
                    },
                    "escorts": {
                        "type": "array",
                        "description": "護衛リスト",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "escorts_id",
                                "escort_num"
                            ],
                            "properties": {
                                "escorts_id": {
                                    "type": "integer",
                                    "description": "護衛モンスターID",
                                    "minimum": 1,
                                    "maximum": 9999
                                },
                                "escort_num": {
                                    "type": "string",
                                    "description": "護衛生成数 XdY形式",
                                    "pattern": "[1-9][0-9]*d[1-9][0-9]*"
                                }
                            }
                        }
                    },
                    "blows": {
                        "type": "array",
                        "description": "物理攻撃",
                        "items": {
                            "type": "object",
                            "maxItems": 4,
                            "additionalProperties": false,
                            "required": [
                                "method",
                                "effect"
                            ],
                            "properties": {
                                "method": {
                                    "type": "string",
                                    "description": "打撃手段"
                                },
                                "effect": {
                                    "type": "string",
                                    "description": "打撃属性"
                                },
                                "damage_dice": {
                                    "type": "string",
                                    "description": "ダメージダイス。XdY形式",
                                    "pattern": "[0-9]+d[0-9]+"
                                }
                            }
                        }
                    },
                    "flags": {
                        "type": "array",
                        "description": "モンスターフラグ",
                        "items": {
                            "type": "string"
                        }
                    },
                    "skill": {
                        "type": "object",
                        "description": "発動型能力",
                        "additionalProperties": false,
                        "anyOf": [
                            {
                                "required": [
                                    "probability",
                                    "list"
                                ]
                            },
                            {
                                "required": [
                                    "probability",
                                    "shoot"
                                ]
                            },
                            {
                                "required": [
                                    "probability",
                                    "list",
                                    "shoot"
                                ]
                            }
                        ],
                        "properties": {
                            "probability": {
                                "type": "string",
                                "description": "能力使用確率",
                                "pattern": "1_IN_[1-9][0-9]*"
                            },
                            "shoot": {
                                "type": "string",
                                "description": "射撃威力。XdY方式",
                                "pattern": "[1-9][0-9]*d[1-9][0-9]*"
                            },
                            "list": {
                                "type": "array",
                                "description": "発動型能力リスト",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "flavor": {
                        "type": "object",
                        "description": "フレーバーテキスト",
                        "additionalProperties": false,
                        "required": [
                            "ja"
                        ],
                        "properties": {
                            "ja": {
                                "type": "string",
                                "description": "日本語フレーバーテキスト"
                            },
                            "en": {
                                "type": "string",
                                "description": "English Flavor Text"
                            }
                        }
                    },
                    "final_summon": {
                        "type": "array",
                        "description": "死亡時召喚",
                        "items": {
                            "type": "object",
                            "required": [
                                "id",
                                "probability",
                                "min_num",
                                "max_num",
                                "radius"
                            ],
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "description": "召喚するモンスターID",
                                    "minimum": 1,
                                    "maximum": 9999
                                },
                                "probability": {
                                    "type": "integer",
                                    "description": "召喚する確率。probability/100で召喚する。",
                                    "minimum": 1,
                                    "maximum": 100
                                },
                                "min_num": {
                                    "type": "integer",
                                    "description": "召喚数の下限",
                                    "minimum": 0,
                                    "maximum": 99
                                },
                                "max_num": {
                                    "type": "integer",
                                    "description": "召喚数の上限",
                                    "minimum": 1,
                                    "maximum": 99
                                },
                                "radius": {
                                    "type": "integer",
                                    "description": "召喚先の距離",
                                    "minimum": 1,
                                    "maximum": 20
                                }
                            }
                        }
                    },
                    "message": {
                        "type": "array",
                        "description": "メッセージ",
                        "items": {
                            "type": "object",
                            "maxItems": 3,
                            "additionalProperties": false,
                            "required": [
                                "action",
                                "chance",
                                "message"
                            ],
                            "properties": {
                                "action": {
                                    "type": "string",
                                    "description": "メッセージトリガーとなる行動",
                                    "enum": [
                                        "SPEAK_ALL",
                                        "SPEAK_BATTLE",
                                        "SPEAK_FEAR",
                                        "SPEAK_FRIEND",
                                        "SPEAK_DEATH",
                                        "SPEAK_SPAWN",
                                        "WALK_CLOSERANGE",
                                        "WALK_MIDDLERANGE",
                                        "WALK_LONGRANGE",
                                        "MESSAGE_STALKER",
                                        "MESSAGE_REFLECT",
                                        "MESSAGE_TIMESTOP",
                                        "MESSAGE_TIMESTART",
                                        "MESSAGE_BREATH_SOUND",
                                        "MESSAGE_BREATH_SHARDS",
                                        "MESSAGE_BREATH_FORCE",
                                        "MESSAGE_DETECT_UNIQUE"
                                    ]
                                },
                                "chance": {
                                    "type": "integer",
                                    "description": "メッセージ発生率。1/chanceで機能する。",
                                    "minimum": 1,
                                    "maximum": 100
                                },
                                "use_name": {
                                    "type": "boolean",
                                    "description": "メッセージの先頭にモンスター名を表示する。"
                                },
                                "message": {
                                    "type": "object",
                                    "description": "メッセージ",
                                    "additionalProperties": false,
                                    "required": [
                                        "ja"
                                    ],
                                    "properties": {
                                        "ja": {
                                            "type": "string",
                                            "description": "日本語メッセージ"
                                        },
                                        "en": {
                                            "type": "string",
                                            "description": "English Message"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "terrain_feature": {
                        "type": "array",
                        "description": "地形変化率",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "id",
                                "probability"
                            ],
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "description": "変化先地形ID",
                                    "minimum": 0,
                                    "maximum": 9999
                                },
                                "probability": {
                                    "type": "string",
                                    "description": "確率。X_IN_Y形式",
                                    "pattern": "[1-9][0-9]*_IN_[1-9][0-9]*"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "required": [
        "versions",
        "monsters"
    ]
}
