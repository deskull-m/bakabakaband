{
  "version": 1,
  "id": 36,
  "name": {
    "ja": "迫真空手部性の裏技",
    "en": "The Hakusin Karate",
  },
  "definition": {
    "type": "KILL_ALL",
    "level": 45,
    "flags": ["PRESET", "ONCE"],
  },
  "descriptions": [
    {
      "when": {
        "statusAtMost": "COMPLETED",
      },
      "text": {
        "ja": [
          "鈴木先輩の股間はいつも盛り上がってる。",
          "俺は気になってしょうがない。",
          "初めてみる先輩の・・・。でも、先輩たちのいじめは俺の想像を越えていた。",
          "「お前のほしいのはこれなんだろ？」",
          "雄達の秘密の楽しみ体育会・性のいじめ。",
          "いじめは良くないので全員を叩きのめしてきてください。",
        ],
        // 旧 q0seinourawaza.txt には受託時の英語版説明文が存在しないため空とする
        "en": [],
      },
    },
    {
      "when": {
        "status": "REWARDED",
      },
      "text": {
        "ja": ["素晴らしい!! ご褒美を外に置いておきました。"],
        "en": ["Impressive!! Your reward is waiting for you outside."],
      },
    },
    {
      "when": {
        "status": "FAILED",
      },
      "text": {
        "ja": ["この淫夢はあなたには難しかったようですね。"],
        "en": ["It seems like this INM was too difficult for you."],
      },
    },
  ],
