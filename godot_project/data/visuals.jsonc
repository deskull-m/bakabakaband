// 3D 表示などの見た目の定義 (#9297)
//
// 解決の順番 (scripts/visual_catalog.gd):
//   地形:     terrain.by_tag[地形のタグ] → terrain.by_shape[形状] → 文字のビルボード
//   クリーチャー: monsters.by_race[種族 ID] → monsters.by_symbol[文字] → 文字のビルボード
//   床アイテム: items.by_tval[種別の番号] → 文字のビルボード
// どれにも当てはまらなければ、端末と同じ文字・色のビルボードになる (定義が空でも全て描ける)。
//
// 1 件の書式 (どれも省略可):
//   "mesh":   メッシュのリソース (res://...)。指定があればメッシュを置く
//   "sprite": テクスチャのリソース (res://...)。指定があればスプライトのビルボード
//   "scale":  大きさの倍率 (既定 1.0)
//   "height": 高さ (グリッド = 1.0。壁・扉の箱の高さなど)
//   "color":  色 ("#rrggbb")。無ければ端末の色
//   "shape":  "box" (箱) / "plane" (床の板) / "none" (置かない)。mesh も sprite も無いときの形
//   "overlay_glyph": true なら箱・板の上に端末の文字のビルボードも立てる (罠など、文字で見分ける地形)
//   "texture": 箱・板に貼るテクスチャの名前 (assets/textures/terrain/<名前>.png、128x128)。
//             色はテクスチャに端末の地形の色を掛けて付くので、テクスチャは明暗の模様だけでよい。
//             tools/godot/gen-terrain-textures.py が生成する
{
  "version": 1,
  "terrain": {
    // 形状 (ObservedTerrainShape の名前) ごとの既定
    "by_shape": {
      "FLOOR": { "shape": "plane", "texture": "floor" },
      "WALL": { "shape": "box", "height": 1.0, "texture": "wall" },
      "DOOR_CLOSED": { "shape": "box", "height": 0.9, "scale": 0.8, "texture": "door" },
      "DOOR_OPEN": { "shape": "plane", "texture": "floor" },
      "STAIRS_UP": { "shape": "plane", "texture": "stairs_up" },
      "STAIRS_DOWN": { "shape": "plane", "texture": "stairs_down" },
      "LIQUID": { "shape": "plane", "texture": "liquid" },
      "TREE": { "shape": "box", "height": 1.2, "scale": 0.6, "texture": "tree" },
      "ENTRANCE": { "shape": "box", "height": 1.0, "texture": "door" },
      "OTHER_PASSABLE": { "shape": "plane", "texture": "dirt" },
      "OTHER_OBSTACLE": { "shape": "box", "height": 0.8, "texture": "rubble" },
      // 見つけた罠は床の板に端末の文字 (^ の色) を立てて見分けられるようにする
      "TRAP": { "shape": "plane", "texture": "floor", "overlay_glyph": true }
    },
    // 地形のタグ (lib/edit/TerrainDefinitions.jsonc の key) ごとの上書き
    "by_tag": {
      "PERMANENT": { "shape": "box", "height": 1.2, "texture": "permanent" },
      "PERMANENT_INNER": { "shape": "box", "height": 1.2, "texture": "permanent" },
      "PERMANENT_OUTER": { "shape": "box", "height": 1.2, "texture": "permanent" },
      "PERMANENT_SOLID": { "shape": "box", "height": 1.2, "texture": "permanent" },
      "MAGMA_VEIN": { "shape": "box", "height": 1.0, "texture": "vein" },
      "QUARTZ_VEIN": { "shape": "box", "height": 1.0, "texture": "vein" },
      "MAGMA_TREASURE": { "shape": "box", "height": 1.0, "texture": "vein" },
      "QUARTZ_TREASURE": { "shape": "box", "height": 1.0, "texture": "vein" },
      "BLICK_MANSONRY_WALL": { "shape": "box", "height": 1.0, "texture": "brick" },
      "WOOD_WALL": { "shape": "box", "height": 1.0, "texture": "wood_wall" },
      "RUBBLE": { "shape": "box", "height": 0.5, "texture": "rubble" },
      "GRASS": { "shape": "plane", "texture": "grass" },
      "FLOWER": { "shape": "plane", "texture": "grass" },
      "DIRT": { "shape": "plane", "texture": "dirt" },
      "FLAGSTONE": { "shape": "plane", "texture": "permanent" }
    }
  },
  "monsters": {
    // 表示の文字ごとの既定 (例: 竜は大きく)
    "by_symbol": {
      "D": { "scale": 1.8 },
      "d": { "scale": 1.2 }
    },
    // 種族 ID ごとの上書き
    "by_race": {}
  },
  "items": {
    "by_tval": {}
  }
}
