<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="UserMacros">
    <BakabakabandDebugBuild Condition="$(Configuration.EndsWith('Debug'))">true</BakabakabandDebugBuild>
    <BakabakabandJapanese Condition="!$(Configuration.StartsWith('English'))">true</BakabakabandJapanese>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization Condition="'$(BakabakabandDebugBuild)'!='true'">true</WholeProgramOptimization>
    <UseDebugLibraries Condition="'$(BakabakabandDebugBuild)'=='true'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(BakabakabandDebugBuild)'!='true'">false</UseDebugLibraries>
  </PropertyGroup>
</Project>
